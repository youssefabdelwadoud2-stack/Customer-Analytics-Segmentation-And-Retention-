      <column caption='Review Score' datatype='string' name='[Calculation_0329896678195200]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='STR([avg_review_score])' />
      </column>
      <column caption='Churn Rate ' datatype='integer' name='[Calculation_0383494471643137]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [churned]  THEN 1 &#13;&#10;ELSE 0&#13;&#10;END' />
      </column>
      <column caption='AVG Customer Value' datatype='real' name='[Calculation_0383494474276868]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG([total_spend_usd])' />
      </column>
      <column caption='Zero' datatype='integer' name='[Calculation_1450296597196800]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='0' />
      </column>
      <column caption='Churn Status' datatype='string' name='[Calculation_1450296608415745]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_1569868179894276] = 1 THEN &quot;Churned&quot; ELSE &quot;Active&quot; END' />
      </column>
      <column caption='Review Behavior' datatype='string' name='[Calculation_1450296650416130]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [reviews_given] &gt; 0 THEN &quot;Has Reviews&quot; &#13;&#10;ELSE &quot;No Reviews&quot; END' />
      </column>
      <column caption='Wishlist Activity' datatype='string' name='[Calculation_1450296650903555]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [wishlist_items] &gt; 0 THEN &quot;Has Wishlist Items&quot; &#13;&#10;ELSE &quot;No Wishlist Items&quot; END' />
      </column>
      <column caption='At Risk Customers' datatype='integer' name='[Calculation_1450296685428740]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(IF [risk_segment] = &quot;High Risk&quot;&#13;&#10; THEN [customer_id] END)' />
      </column>
      <column caption='At Risk Customer Value' datatype='integer' name='[Calculation_1450296685862917]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [risk_segment] = &quot;High Risk&quot;&#13;&#10; THEN [total_spend_usd] END)' />
      </column>
      <column caption='AVG Recency of At Risk Customers' datatype='real' name='[Calculation_1450296686063622]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG(IF [risk_segment] = &quot;High Risk&quot; &#13;&#10;THEN [days_since_last_purchase] END)' />
      </column>

    <worksheet name='D3 Cards'>
      <table>
        <view>
          <datasources>
            <datasource caption='E-Commerce Customer Behavior &amp; Sales Data (Customer)' name='federated.0nqosof0jwfgd1110q3pu1pm1yi8' />
          </datasources>
          <datasource-dependencies datasource='federated.0nqosof0jwfgd1110q3pu1pm1yi8'>
            <column caption='Churn Rate ' datatype='integer' name='[Calculation_0383494471643137]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [churned]  THEN 1 &#13;&#10;ELSE 0&#13;&#10;END' />
            </column>
            <column caption='Churnes  Rate' datatype='real' name='[Calculation_1569868179894276]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IIF([Calculation_0383494471643137]=1,1,0)) / COUNTD([customer_id])' />
            </column>
            <column caption='Active Customer' datatype='integer' name='[Calculation_1950024081031170]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(&#13;&#10;    IF [Customer_segment] = &apos;Active&apos;&#13;&#10;    THEN [customer_id]&#13;&#10;    END&#13;&#10;)' />
            </column>
